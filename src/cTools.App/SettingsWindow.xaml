<Window x:Class="cTools.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cTools 设置" Width="1000" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="NavTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavTabControl" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource NavTabItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}" Padding="16,22">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                      <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                 Foreground="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="cTools" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="极速启动器" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Row="1" IsItemsHost="True" Margin="0,24,0,0" KeyboardNavigation.TabIndex="1" />
                </Grid>
              </Border>

              <Border Grid.Column="1" Padding="28,24,22,0" ClipToBounds="True">
                <ContentPresenter ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="SettingsTabs" Grid.Row="0" Style="{StaticResource NavTabControl}">
      <!-- 0 常规 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="常规" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" ClipToBounds="True">
          <StackPanel>
            <TextBlock Text="常规" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="启动方式、窗口行为与搜索文本的保留策略。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="启动与托盘" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="开机启动会以 --background 参数运行，只保留托盘与全局快捷键。" Style="{StaticResource SectionHint}" />
                <CheckBox x:Name="StartWithWindowsBox" Content="开机自动启动（后台运行）" />
                <CheckBox x:Name="ShowTrayBox" Content="在系统托盘显示图标" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="紧凑模式在没有输入时只保留搜索框，开始输入后自动展开。" Style="{StaticResource SectionHint}" />
                <CheckBox x:Name="HideOnBlurBox" Content="失去焦点时自动隐藏" />
                <CheckBox x:Name="CompactModeBox" Content="紧凑模式（仅搜索框，输入后展开）" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="搜索文本" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="决定每次呼出面板时搜索框的状态。" Style="{StaticResource SectionHint}" />
                <CheckBox x:Name="SelectSearchTextBox" Content="打开时选中上次的搜索文本" />
                <CheckBox x:Name="KeepSearchTextBox" Content="关闭后保留上次搜索内容" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="结果数量" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="建议 30–80。数量越大，长列表的滚动与图标加载成本越高。" Style="{StaticResource SectionHint}" />
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="MaxResultsBox" Width="110" HorizontalAlignment="Left" />
                  <TextBlock Text="条" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubTextBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 1 外观与布局 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="外观与布局" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" ClipToBounds="True">
          <StackPanel>
            <TextBlock Text="外观与布局" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="主题、呼出屏幕、竖直位置，以及搜索结果的呈现方式。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="窗口材质会跟随系统深浅色自动切换。" Style="{StaticResource SectionHint}" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="ThemeLightRadio" Content="浅色" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="ThemeDarkRadio" Content="深色" Style="{StaticResource SegmentRadio}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="呼出屏幕" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="可以选择鼠标所在屏幕、主屏、当前窗口所在屏幕，或固定某一块显示器。" Style="{StaticResource SectionHint}" />
                <ComboBox x:Name="MonitorCombo" Width="380" HorizontalAlignment="Left" DisplayMemberPath="Label" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="呼出位置" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="面板会在这块屏幕的可用区域内水平居中。" Style="{StaticResource SectionHint}" />
                <WrapPanel>
                  <RadioButton x:Name="PosTopRadio" Content="顶部" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="PosUpperRadio" Content="上部" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="PosCenterRadio" Content="居中" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="PosLowerRadio" Content="下部" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="PosBottomRadio" Content="底部" Style="{StaticResource SegmentRadio}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="结果展示" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="列表模式信息密度更高；网格模式更适合图标识别，方向键可在行列间移动。" Style="{StaticResource SectionHint}" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="LayoutListRadio" Content="列表" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="LayoutGridRadio" Content="网格" Style="{StaticResource SegmentRadio}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2 搜索范围 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="搜索范围" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" ClipToBounds="True">
          <StackPanel>
            <TextBlock Text="搜索范围" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="控制哪些来源进入索引。默认参考 uTools：开始菜单、桌面、App Paths 与 UWP。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="默认来源" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="关闭某个来源后，重建索引时就不会再扫描它。" Style="{StaticResource SectionHint}" />
                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox Grid.Row="0" Grid.Column="0" x:Name="StartMenuBox" Content="开始菜单（用户 + 公共）" />
                  <CheckBox Grid.Row="0" Grid.Column="1" x:Name="DesktopBox" Content="桌面快捷方式（用户 + 公共）" />
                  <CheckBox Grid.Row="1" Grid.Column="0" x:Name="AppPathsBox" Content="注册表 App Paths" />
                  <CheckBox Grid.Row="1" Grid.Column="1" x:Name="UwpBox" Content="UWP / Microsoft Store 应用" />
                  <CheckBox Grid.Row="2" Grid.Column="0" x:Name="CustomEntriesBox" Content="自定义启动项" />
                  <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CustomPathsBox" Content="自定义扫描路径" />
                  <CheckBox Grid.Row="3" Grid.Column="0" x:Name="SystemSettingsBox" Content="Windows 设置页面（可选）" />
                </Grid>
                <CheckBox x:Name="IncludeSubfoldersBox" Content="递归扫描开始菜单 / 桌面的子目录" Margin="0,10,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="最大扫描深度" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" />
                  <TextBox x:Name="MaxDepthBox" Width="70" VerticalAlignment="Center" Margin="10,0,8,0" />
                  <TextBlock Text="层" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="扫描的文件类型" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="开始菜单 / 桌面只收录快捷方式；自定义扫描路径的目录会按这里的扩展名收录文件，单独添加的文件不受限制。" Style="{StaticResource SectionHint}" />
                <WrapPanel>
                  <CheckBox x:Name="ScanExeBox" Content="应用 .exe" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanLnkBox" Content="快捷方式 .lnk" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanUrlBox" Content="网址 .url" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanAppRefBox" Content="ClickOnce .appref-ms" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanBatBox" Content="批处理 .bat / .cmd" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanPs1Box" Content="PowerShell .ps1" Margin="0,5,20,5" />
                  <CheckBox x:Name="ScanMsiBox" Content="安装包 .msi" Margin="0,5,20,5" />
                </WrapPanel>
                <TextBlock Text="其他扩展名（逗号分隔，例如 .ahk, .py, .jar）" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                <TextBox x:Name="ExtraExtensionsBox" />              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="自定义扫描路径" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="文件夹会递归收录；也可以添加单个文件。列表里的“递归”只对文件夹生效。" Style="{StaticResource SectionHint}" />
                <ListView x:Name="CustomPathsList" Height="168" AllowDrop="True" DragOver="CustomList_DragOver" Drop="CustomPathsList_Drop"
                          Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" Padding="4">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="启用" Width="58">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="" Margin="0" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                      <GridViewColumn Header="类型" Width="64" DisplayMemberBinding="{Binding KindLabel}" />
                      <GridViewColumn Header="路径" Width="380" DisplayMemberBinding="{Binding Path}" />
                      <GridViewColumn Header="递归" Width="58">
                        <GridViewColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding Recursive, Mode=TwoWay}" Content="" Margin="0" />
                          </DataTemplate>
                        </GridViewColumn.CellTemplate>
                      </GridViewColumn>
                    </GridView>
                  </ListView.View>
                </ListView>
                <Grid Margin="0,10,0,0">
                  <TextBlock x:Name="CustomPathsCountText" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                             VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="添加文件夹" Click="AddFolder_Click" Margin="0,0,8,0" />
                    <Button Content="添加文件" Click="AddScanFile_Click" Margin="0,0,8,0" />
                    <Button Content="移除选中" Click="RemovePath_Click" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="排除关键词" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="每行一个，支持 * 通配；匹配名称中的任意片段。自定义启动项不会被排除。" Style="{StaticResource SectionHint}" />
                <TextBox x:Name="ExcludePatternsBox" Height="88" AcceptsReturn="True" Padding="11,6"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="索引状态" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="ScanSummaryText" Text="尚未扫描" Style="{StaticResource SectionHint}" Margin="0,0,0,8" />
                <TextBlock Text="“重建索引”会使用当前表单里的范围做一次预览扫描，不会保存设置；保存后才会写入索引缓存。"
                           FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="RebuildButton" Content="重建索引" Click="Rebuild_Click" Margin="0,0,12,0" />
                  <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}" Text="就绪" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 3 自定义启动 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="自定义启动" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,0,4,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="自定义启动" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="文件、文件夹、网址或命令都可以加入索引；参数、工作目录和管理员运行会一并保存。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,16" />
          </StackPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="Transparent" Padding="14,10" Margin="0,0,0,10">
            <TextBlock Text="提示：也可以把文件 / 文件夹直接拖进这个列表。" FontSize="11.5"
                       Foreground="{DynamicResource SubTextBrush}" />
          </Border>

          <ListView Grid.Row="2" x:Name="CustomEntriesList" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4"
                    AllowDrop="True" DragOver="CustomList_DragOver" Drop="CustomEntriesList_Drop"
                    MouseDoubleClick="EditEntry_MouseDoubleClick">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="启用" Width="58">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="" Margin="0" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="目标" Width="280" DisplayMemberBinding="{Binding Target}" />
                <GridViewColumn Header="类型" Width="70" DisplayMemberBinding="{Binding KindLabel}" />
                <GridViewColumn Header="管理员" Width="60">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" Content="" Margin="0" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <WrapPanel Grid.Row="3" Margin="0,12,0,16">
            <Button Content="添加文件" Click="AddFile_Click" Margin="0,0,8,8" />
            <Button Content="添加文件夹" Click="AddFolderEntry_Click" Margin="0,0,8,8" />
            <Button Content="添加网址" Click="AddUrl_Click" Margin="0,0,8,8" />
            <Button Content="添加命令" Click="AddCommand_Click" Margin="0,0,8,8" />
            <Button Content="编辑" Click="EditEntry_Click" Margin="0,0,8,8" />
            <Button Content="删除" Click="DeleteEntry_Click" Margin="0,0,8,8" />
          </WrapPanel>
        </Grid>
      </TabItem>

      <!-- 4 快捷键与行为 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="快捷键与行为" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" ClipToBounds="True">
          <StackPanel>
            <TextBlock Text="快捷键与行为" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="全局唤出、全屏保护、Esc 与空格键的语义都在这里。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="全局唤出快捷键" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="点击输入框后直接按组合键，例如 Alt+Space、Ctrl+Shift+Space；单键仅支持 F1–F24。" Style="{StaticResource SectionHint}" />
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="HotkeyBox" Width="280" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                  <Button Content="恢复默认" Click="ResetHotkey_Click" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="HotkeyStatusText" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="全屏保护" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="检测到游戏、视频或演示模式全屏时，不响应全局快捷键，避免打断全屏应用。" Style="{StaticResource SectionHint}" />
                <CheckBox x:Name="SuppressFullscreenBox" Content="全屏状态下屏蔽快捷键呼出" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="空格确认" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="开启后，空格等同 Enter，会直接启动当前选中项；此时无法再用空格分词搜索。" Style="{StaticResource SectionHint}" />
                <CheckBox x:Name="SpaceToLaunchBox" Content="用空格确认启动" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Esc 行为" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="搜索框为空时始终会隐藏面板；有内容时按这里的设置处理。" Style="{StaticResource SectionHint}" />
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="EscClearRadio" Content="先清空，再按一次隐藏" Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="EscHideRadio" Content="始终直接隐藏" Style="{StaticResource SegmentRadio}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 5 关于 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="24"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <TextBlock Text="关于" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0" ClipToBounds="True">
          <StackPanel>
            <TextBlock Text="关于" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="一个 Windows 优先的极速应用启动器。" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="cTools" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="当前版本聚焦应用快速启动：可配置的扫描范围、自定义文件 / 文件夹 / 网址 / 命令、全局快捷键与面板行为。插件平台会在启动器体验稳定后接入。"
                           FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="19" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="数据目录" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="DataPathText" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,12" LineHeight="18" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="打开数据目录" Click="OpenDataFolder_Click" Margin="0,0,8,0" />
                  <Button Content="打开日志" Click="OpenLog_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="26,14">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="设置保存在 %APPDATA%\cTools\settings.json"
                     FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="SaveStatusText" Text="已保存" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"
                     VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,10,0" />
          <Button Content="保存" Click="Save_Click" Style="{StaticResource AccentButton}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
