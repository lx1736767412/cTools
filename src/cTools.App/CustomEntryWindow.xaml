<Window x:Class="cTools.App.CustomEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义启动项" Width="640" Height="680"
        MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,22,22,0">
      <StackPanel>
        <TextBlock Text="自定义启动项" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="名称会参与搜索；目标可以是任意文件、文件夹、网址或命令。"
                   FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,18" />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="名称必填，会出现在搜索结果的第一行。" Style="{StaticResource SectionHint}" />

            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
            <ComboBox x:Name="KindBox" Width="220" HorizontalAlignment="Left" DisplayMemberPath="Label" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="启动目标" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="文件会用系统默认程序打开；网址和命令会交给 Shell 执行。" Style="{StaticResource SectionHint}" />

            <TextBlock Text="目标" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TargetBox" />
              <Button Grid.Column="1" Content="文件…" Click="BrowseTarget_Click" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="文件夹…" Click="BrowseTargetFolder_Click" Margin="6,0,0,0" />
            </Grid>

            <TextBlock Text="参数（可选）" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
            <TextBox x:Name="ArgumentsBox" />

            <TextBlock Text="工作目录（可选）" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WorkingDirectoryBox" />
              <Button Grid.Column="1" Content="浏览…" Click="BrowseWorkingDirectory_Click" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="搜索与外观" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="关键词会参与拼音、首字母之外的额外匹配；图标留空时使用目标自身的图标。" Style="{StaticResource SectionHint}" />

            <TextBlock Text="关键词（逗号分隔，可选）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="KeywordsBox" />

            <TextBlock Text="图标（可选）" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="IconBox" />
              <Button Grid.Column="1" Content="浏览…" Click="BrowseIcon_Click" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="清除" Click="ClearIcon_Click" Margin="6,0,0,0" />
            </Grid>

            <CheckBox x:Name="EnabledBox" Content="启用此启动项" Margin="0,16,0,0" />
            <CheckBox x:Name="RunAsAdminBox" Content="以管理员身份运行" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="22,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" />
        <Button Content="确定" Click="Ok_Click" Style="{StaticResource AccentButton}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
