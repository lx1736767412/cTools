<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>cTools</AssemblyName>
    <RootNamespace>cTools.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\cTools.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyTitle>cTools</AssemblyTitle>
    <Product>cTools</Product>
    <Company>cTools</Company>
    <Description>Windows 快速应用启动器</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\cTools.Core\cTools.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\cTools.ico" Link="Assets\cTools.ico" />
  </ItemGroup>
</Project>
