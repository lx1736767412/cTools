<Window x:Class="cTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cTools"
        Width="780" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
  <Window.Resources>
    <ItemsPanelTemplate x:Key="GridItemsPanel">
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
    </ItemsPanelTemplate>

    <Style x:Key="GridItemStyle" TargetType="ListBoxItem">
      <Setter Property="Width" Value="84" />
      <Setter Property="Height" Value="84" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="9" Padding="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="GridResultTemplate">
      <StackPanel Margin="2,5,2,3" VerticalAlignment="Top" ToolTip="{Binding GridToolTip}">
        <Grid Width="38" Height="38" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                     Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{Binding Icon}" Stretch="Uniform" Width="36" Height="36"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid Width="76" Height="28" Margin="0,4,0,0" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                     HorizontalAlignment="Stretch" TextAlignment="Center"
                     TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"
                     LineHeight="14" LineStackingStrategy="BlockLineHeight" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="KbdText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" CornerRadius="16" Background="{DynamicResource PaletteBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.28" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition x:Name="ContentRow" Height="*" />
        <RowDefinition x:Name="FooterRow" Height="40" />
      </Grid.RowDefinitions>

      <!-- 搜索头 -->
      <Grid Grid.Row="0" Margin="18,0,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                VerticalAlignment="Center">
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                     Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Column="1" Margin="13,0,12,0">
          <TextBox x:Name="SearchBox" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                   SelectionBrush="{DynamicResource AccentBrush}" FontSize="21" Padding="0"
                   VerticalContentAlignment="Center" SpellCheck.IsEnabled="False"
                   TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
          <TextBlock x:Name="PlaceholderText" Text="搜索应用、文件或命令…" FontSize="21"
                     Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                     Margin="1,0,0,1" IsHitTestVisible="False" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
          <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                     Foreground="{DynamicResource SubTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"
                     ToolTip="管理员运行" Visibility="{Binding Selected.Entry.RunAsAdmin, Converter={StaticResource BoolToVis}}" />
          <Border x:Name="StatusPill" MaxWidth="190" ToolTip="{Binding Status}">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"
                       TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>

        <Button Grid.Column="3" x:Name="SettingsButton" Style="{StaticResource IconButton}"
                ToolTip="设置" Click="SettingsButton_Click">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" />
        </Button>
      </Grid>

      <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="16,0,16,0"
              Background="{DynamicResource BorderBrush}" />

      <!-- 结果区 -->
      <Grid Grid.Row="1">
        <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent" Padding="8,4,4,4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="8,2" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" Padding="1">
                      <Grid>
                        <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" Margin="0,10"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0" />
                        <ContentPresenter Margin="12,0,10,0" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="54">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                  <Grid>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Icon}" Stretch="Uniform" Width="24" Height="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                             Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"
                             ToolTip="需要管理员权限"
                             Visibility="{Binding Entry.RunAsAdmin, Converter={StaticResource BoolToVis}}" />
                  <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="10"
                             Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}"
                  HorizontalAlignment="Center">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="24"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="没有找到匹配项" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
          <TextBlock Text="换个关键词，或把文件 / 文件夹直接拖进来添加" FontSize="11.5"
                     Foreground="{DynamicResource SubTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="添加文件…" Click="AddFileClick" Margin="0,0,8,0" />
            <Button Content="打开设置" Click="OpenSettingsClick" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 底部提示 -->
      <Border x:Name="FooterBorder" Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,16,16" Padding="16,0">
        <Grid Height="40">
          <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"
                     VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Style="{StaticResource KbdChipStyle}">
              <TextBlock x:Name="NavHintText" Text="↑↓ 选择" Style="{StaticResource KbdText}" />
            </Border>
            <Border Style="{StaticResource KbdChipStyle}">
              <TextBlock Text="Enter 打开" Style="{StaticResource KbdText}" />
            </Border>
            <Border Style="{StaticResource KbdChipStyle}" Visibility="Collapsed" x:Name="AdminHintChip">
              <TextBlock Text="Ctrl+Enter 管理员" Style="{StaticResource KbdText}" />
            </Border>
            <Border Style="{StaticResource KbdChipStyle}" Visibility="Collapsed" x:Name="SpaceHintChip">
              <TextBlock Text="Space 启动" Style="{StaticResource KbdText}" />
            </Border>
            <Border Style="{StaticResource KbdChipStyle}">
              <TextBlock Text="Esc 关闭" Style="{StaticResource KbdText}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
