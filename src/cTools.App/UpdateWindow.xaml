<Window x:Class="cTools.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cTools 更新" Width="560" SizeToContent="Height"
        MinWidth="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}">
        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="发现新版本" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0" />
      </StackPanel>
    </StackPanel>

    <Border x:Name="NotesCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
      <StackPanel>
        <TextBlock Text="更新内容" Style="{StaticResource SectionTitle}" />
        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                     Foreground="{DynamicResource SubTextBrush}" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource SubTextBrush}" />
      <ProgressBar x:Name="DownloadProgress" Height="3" Minimum="0" Maximum="100" Value="0"
                   Margin="0,8,0,0" Visibility="Collapsed" BorderThickness="0"
                   Background="{DynamicResource BorderBrush}"
                   Foreground="{DynamicResource AccentBrush}" />
      <Grid Margin="0,14,0,0">
        <CheckBox x:Name="SkipBox" Content="跳过此版本" VerticalAlignment="Center" Margin="0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="LaterButton" Content="稍后" Click="Later_Click" Margin="0,0,10,0" />
          <Button x:Name="InstallButton" Content="下载并安装" Style="{StaticResource AccentButton}" Click="Install_Click" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
